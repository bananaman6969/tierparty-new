generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Das ist unser User-Model für Phase 1
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hier speichern wir später den Hash, kein Klartext!
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}